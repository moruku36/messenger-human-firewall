{
  "name": "messenger-human-firewall",
  "version": "0.1.0",
  "description": "Local resident AI reception & firewall system for Facebook Messenger",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "pause": "tsx src/cli/control.ts pause",
    "resume": "tsx src/cli/control.ts resume",
    "status": "tsx src/cli/control.ts status",
    "dashboard": "tsx src/dashboard/index.ts",
    "login": "tsx src/cli/login.ts"
  },
  "keywords": [
    "facebook-messenger",
    "firewall",
    "ai-agent",
    "playwright",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "private": false,
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
