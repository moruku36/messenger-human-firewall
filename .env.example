# Messenger Human Firewall Configuration

# Execution Modes
DRY_RUN=true
PAUSE_ALL=false

# LLM Configuration (Provider: gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Model Selection
GEMINI_MODEL=gemini-3.6-flash

# TypeSafe Jev Configuration (Production Semantic Triage & Shadow Mode)
# Active Production Mode (Recommended): JEV_ENABLED=true, JEV_SHADOW_MODE=false
# Shadow Telemetry Mode: JEV_ENABLED=true, JEV_SHADOW_MODE=true
# Legacy Mode: JEV_ENABLED=false
JEV_ENABLED=true
JEV_SHADOW_MODE=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=5000
JEV_HIGH_RISK_THRESHOLD=0.85
JEV_MIN_CONFIDENCE=0.80

# Browser / Session Configuration
BROWSER_USER_DATA_DIR=data/browser-profile
HEADLESS=false

# ==============================================================================
# Rate Limiting & Safety Controls
# ==============================================================================
# [Testing / Controlled Send Safeguards]
# Send-gate scope:
# - 'test_thread_only' (default): strictly matches ALLOWED_TEST_THREAD_ID
# - 'all_threads' (experimental): bypasses the allowlist check only
# IMPORTANT: The watcher currently scans Message Requests, and unaccepted requests have no
# composer in the verified real DOM. 'all_threads' does NOT auto-accept or make those requests
# sendable. Missing/unavailable composers fail closed to HUMAN_REQUIRED.
AUTO_REPLY_SCOPE=test_thread_only

# Phase 5: Hard limit per allowed thread during controlled testing (default: 3)
CONTROLLED_MAX_REPLIES=3
# Only send live replies to this specific test thread when AUTO_REPLY_SCOPE=test_thread_only:
# the id from the thread URL (messenger.com/t/<id> or /e2ee/t/<id>) or its SHA-256 hash
ALLOWED_TEST_THREAD_ID=

# [Production / Operational Ceilings]
# Absolute daily ceiling per thread in normal operations (rolling 24-hour window)
MAX_REPLIES_PER_THREAD_PER_DAY=20
# Global hard cap for upstream LLM calls across all threads per day (API cost explosion prevention)
MAX_LLM_REQUESTS_PER_DAY=100
# Minimum wait interval between successive replies to avoid burst detection
MIN_REPLY_INTERVAL_SECONDS=15

# Watcher Loop
# How often (in seconds) the resident watcher re-scans Message Requests
WATCH_POLL_INTERVAL_SECONDS=60
# true: also process request threads that show no unread marker (their last message is still
# only handled once, deduplicated by hash). Useful for validating the pipeline on existing threads.
SCAN_INCLUDE_READ_THREADS=false
# Also scan the "スパム / Spam" tab of Message Requests (each thread costs LLM requests)
SCAN_SPAM_TAB=true

# Storage
DATABASE_PATH=data/firewall.db

# Server / Dashboard (local dashboard port; DATABASE_PATH above is shared with the watcher)
PORT=3000
