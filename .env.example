# Messenger Human Firewall Configuration

# Execution Modes
DRY_RUN=true
PAUSE_ALL=false

# LLM Configuration (Provider: gemini | openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model Selection
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Browser / Session Configuration
BROWSER_USER_DATA_DIR=data/browser-profile
HEADLESS=false

# Rate Limiting & Safety Controls
MAX_REPLIES_PER_THREAD_PER_DAY=20
MIN_REPLY_INTERVAL_SECONDS=15

# Storage
DATABASE_PATH=data/firewall.db

# Server / Dashboard
PORT=3000
